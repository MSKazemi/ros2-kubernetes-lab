root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,sh}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.csv]
end_of_line = unset
insert_final_newline = unset

[*.{bat,cmd,ps1}]
end_of_line = crlf
