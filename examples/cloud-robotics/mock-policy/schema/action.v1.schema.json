{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MSKazemi/ros2-kubernetes-lab/examples/cloud-robotics/mock-policy/schema/action.v1.schema.json",
  "title": "Simulated action message, contract ros2-obs-action/v1",
  "description": "Documentation of the contract. The executable authority is validate.py (it also checks the source allow-list, staleness against a caller-supplied clock, replay/sequence order, the referenced observation and per-joint limits). Simulated educational contract; not a safety gate; source_id is not authentication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "simulated", "source_id", "sequence_id", "observation_id", "created_timestamp_ns", "ttl_ms", "task_id", "model_id", "model_revision", "command", "action_space", "units", "values"],
  "properties": {
    "contract_version": {"const": "ros2-obs-action/v1"},
    "simulated": {"const": true},
    "source_id": {"$ref": "#/$defs/identifier"},
    "sequence_id": {"type": "integer", "minimum": 0, "maximum": 9007199254740992},
    "observation_id": {"$ref": "#/$defs/identifier"},
    "created_timestamp_ns": {"type": "integer", "minimum": 0, "maximum": 9007199254740992, "description": "Same monotonic clock domain as the observation."},
    "ttl_ms": {"type": "integer", "minimum": 1, "maximum": 10000},
    "task_id": {"$ref": "#/$defs/identifier"},
    "model_id": {"$ref": "#/$defs/identifier"},
    "model_revision": {"$ref": "#/$defs/identifier"},
    "command": {"enum": ["set_joint_targets"]},
    "action_space": {"const": "joint_position_target"},
    "units": {"const": ["rad", "rad", "rad", "rad", "rad", "m"]},
    "values": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"type": "number", "minimum": -3.1416, "maximum": 3.1416},
        {"type": "number", "minimum": -1.7, "maximum": 1.7},
        {"type": "number", "minimum": -1.7, "maximum": 1.7},
        {"type": "number", "minimum": -1.8, "maximum": 1.8},
        {"type": "number", "minimum": -3.1416, "maximum": 3.1416},
        {"type": "number", "minimum": 0.0, "maximum": 0.08}
      ],
      "items": false
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}
  }
}
